# ==========================================
# SkillPath-AI Environment Configuration Template
# Copy to .env or configure in system environment
# ==========================================

# Server Port
PORT=8080

# Spring Active Profiles (default / prod)
SPRING_PROFILES_ACTIVE=default

# Security & JWT Authentication
# Secret must be a secure 256-bit+ HMAC-SHA256 string
JWT_SECRET=YourSecure256BitOrHigherSecretKeyForJwtAuthenticationMustBeConfiguredHere
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated - add your Netlify/Render frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://*.netlify.app,https://*.onrender.com

# Database Configuration (Optional - Defaults to H2 In-Memory with zero config)
# For Render PostgreSQL:
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<database>
# SPRING_DATASOURCE_USERNAME=<user>
# SPRING_DATASOURCE_PASSWORD=<password>
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
#
# For MySQL:
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/skillpath_ai?createDatabaseIfNotExist=true&useSSL=false
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=your_mysql_password
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
# SPRING_JPA_HIBERNATE_DDL_AUTO=update
