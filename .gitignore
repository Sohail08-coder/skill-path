# ==========================================
# SkillPath-AI Root .gitignore
# ==========================================

# Junction / nested workspace
SkillPath-AI/

# Compiled Java / Maven target directories
target/
backend/target/
**/target/
*.class

# Maven wrapper jar (can be regenerated)
!.mvn/wrapper/maven-wrapper.jar
!backend/.mvn/wrapper/maven-wrapper.jar

# Log files
*.log
logs/
backend/logs/

# Package & Archive files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual Machine crash logs
hs_err_pid*
replay_pid*

# ==========================================
# IDE & Editor Files
# ==========================================
.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
.vscode/
*.sublime-project
*.sublime-workspace

# ==========================================
# Frontend & Node Dependencies
# ==========================================
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
**/dist/
.cache/

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Environment variables
.env
.env.local
.env.*.local
